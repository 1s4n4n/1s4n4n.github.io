---
import { Image } from 'astro:assets'

import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'programs', text: 'Projects' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/1s4n4n'
      format='svg'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  <p>
    A showcase of open-source projects, security tools, and applications I have worked on.
  </p>

  <h2 id='programs'>Projects</h2>
  <ProjectSection
    projects={[
      {
        name: 'CrypTalk',
        image: 'cryptalk.png',
        description: 'End-to-end encrypted chat with AES-256 & RSA, VoIP jitter buffering, and OpenCV video call.',
        links: [
          { type: 'github', href: 'https://github.com/1s4n4n/NT106.Q12.1-Project-CrypTalk' }
        ]
      }
    ]}
  />
</PageLayout>