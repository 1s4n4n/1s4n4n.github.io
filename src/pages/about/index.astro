---
import PageLayout from '@/layouts/CommonPage.astro'
---

<PageLayout title='About'>
  {/* Banner Image */}
  <div class='mt-4 mb-6 overflow-hidden rounded-xl border border-border'>
    <img 
      src='/images/about-banner.png' 
      alt='About Banner' 
      class='w-full max-h-[360px] object-cover object-center transition-all duration-300 hover:scale-[1.02]' 
    />
  </div>

  {/* Intro Text - Thu gọn khoảng cách dòng */}
  <div class='flex flex-col gap-y-1.5 text-base leading-relaxed'>
    <p class='my-0'>This is <strong>nanasi</strong>'s place.</p>
    <p class='my-0'>Specialize in Mobile Security, Reverse Engineering and Web Exploitation.</p>
    <p class='my-0'>I research everything about low-level stuff & computer security.</p>
  </div>

  {/* Contact Buttons */}
  <div class='mt-6 flex flex-col gap-2.5'>
    <h2 class='text-2xl sm:text-3xl font-bold text-foreground'>Contact</h2>
    <div class='flex flex-wrap gap-3'>
      {/* LinkedIn */}
      <a 
        href='https://www.linkedin.com/in/le-minh-sang-598b86346/' 
        target='_blank' 
        rel='noreferrer' 
        class='inline-flex items-center gap-2 rounded-lg border border-border bg-card px-3.5 py-2 text-sm font-medium hover:border-primary/50 hover:text-primary transition-colors'
      >
        <svg class='h-4 w-4 fill-current' viewBox='0 0 24 24'>
          <path d='M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.25c-.91 0-1.64.73-1.64 1.64s.73 1.64 1.64 1.64 1.64-.73 1.64-1.64-.73-1.64-1.64-1.64Z'/>
        </svg>
        LinkedIn
      </a>

      {/* Discord */}
      <a 
        href='https://discord.com/users/1125008722901614663' 
        target='_blank' 
        rel='noreferrer' 
        class='inline-flex items-center gap-2 rounded-lg border border-border bg-card px-3.5 py-2 text-sm font-medium hover:border-primary/50 hover:text-primary transition-colors'
      >
        <svg class='h-4 w-4 fill-current' viewBox='0 0 24 24'>
          <path d='M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z'/>
        </svg>
        Discord
      </a>

      {/* Gmail */}
      <a 
        href='mailto:emsenghutbin@v1t.site' 
        class='inline-flex items-center gap-2 rounded-lg border border-border bg-card px-3.5 py-2 text-sm font-medium hover:border-primary/50 hover:text-primary transition-colors'
      >
        <svg class='h-4 w-4 fill-current' viewBox='0 0 24 24'>
          <path d='M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z'/>
        </svg>
        Gmail
      </a>
    </div>
  </div>

  {/* Spotify Embed Player */}
  <div class='mt-6 flex flex-col gap-2.5'>
    <h2 class='text-2xl sm:text-3xl font-bold text-foreground'>My fav playlist recently</h2>
    <div class='overflow-hidden rounded-xl border border-border bg-card'>
      <iframe 
        data-testid='embed-iframe' 
        style='border-radius:12px' 
        src='https://open.spotify.com/embed/playlist/6FGlY7KUsez5GLeqFF7hez?utm_source=generator&si=5e8430f5b9664fbf' 
        width='100%' 
        height='152' 
        allowfullscreen='' 
        allow='autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture' 
        loading='lazy'>
      </iframe>
    </div>
  </div>
</PageLayout>