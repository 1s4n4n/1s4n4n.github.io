<script>
  // 1. Hacker Text Scramble Effect
  function setupTextScramble() {
    const letters = '01ABCDEF<>/{}_-~#*!&';
    const target = document.getElementById('hacker-title');
    if (!target) return;

    let interval: number | null = null;
    const originalText = target.dataset.value || target.innerText;

    const runScramble = () => {
      let iteration = 0;
      if (interval) clearInterval(interval);

      interval = window.setInterval(() => {
        target.innerText = originalText
          .split('')
          .map((char, index) => {
            if (index < iteration) {
              return originalText[index];
            }
            return letters[Math.floor(Math.random() * letters.length)];
          })
          .join('');

        if (iteration >= originalText.length) {
          if (interval) clearInterval(interval);
        }
        iteration += 1 / 3;
      }, 30);
    };

    runScramble();
    target.onmouseenter = runScramble;
  }

  // 2. Typewriter Effect for Subtitle
  function setupTypewriter() {
    const el = document.getElementById('typewriter-text');
    if (!el) return;

    const phrases = [
      'Attack - Defense CTF Player',
      'Intern Mobile Security Engineer',
      'Reverse Engineering & Pwnable Enthusiast',
      'Press ` or Ctrl+K for CLI Terminal'
    ];
    let phraseIdx = 0;
    let charIdx = 0;
    let isDeleting = false;

    function type() {
      const current = phrases[phraseIdx];
      if (isDeleting) {
        el!.textContent = current.substring(0, charIdx - 1);
        charIdx--;
      } else {
        el!.textContent = current.substring(0, charIdx + 1);
        charIdx++;
      }

      let speed = isDeleting ? 30 : 60;

      if (!isDeleting && charIdx === current.length) {
        speed = 2000; // Dừng lại 2s khi gõ xong
        isDeleting = true;
      } else if (isDeleting && charIdx === 0) {
        isDeleting = false;
        phraseIdx = (phraseIdx + 1) % phrases.length;
        speed = 400;
      }

      setTimeout(type, speed);
    }

    type();
  }

  function initHomeEffects() {
    setupTextScramble();
    setupTypewriter();
  }

  initHomeEffects();
  document.addEventListener('astro:page-load', initHomeEffects);
</script>