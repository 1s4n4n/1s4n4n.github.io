---
import { Image } from 'astro:assets'

import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import config from '@/site-config'

const posts = sortMDByDate(await getBlogCollection()).slice(0, 4)
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
const avatar = images[config.logo.src]
if (!avatar) throw new Error(`Avatar not found: ${config.logo.src}`)
---

<PageLayout meta={{ title: 'Home' }}>
  <main class='home-content'>
    <section class='home-intro' id='content-header' aria-labelledby='home-title'>
      <Image
        src={avatar()}
        alt={config.logo.alt || 'Profile'}
        class='home-avatar'
        width={192}
        format='webp'
        loading='eager'
      />
      <div>
        <p class='intro-eyebrow'>SECURITY · RESEARCH · WRITEUPS</p>
        <h1 id='home-title'>{config.author}</h1>
        <p class='intro-role'>CTF player & mobile security enthusiast.</p>
        <p class='intro-description'>
          Notes on reverse engineering, security, and the things I learn along the way.
        </p>
        <div class='intro-meta'>
          <Label title='HCM City'><Icon name='location' class='size-4' slot='icon' /></Label>
          <a
            href='https://github.com/1s4n4n'
            class='inline-flex items-center gap-2'
            target='_blank'
            rel='noreferrer'><Icon name='github' class='size-4' />GitHub</a
          >
        </div>
        <div class='intro-actions'>
          <Button title='Browse posts' href='/blog' variant='ahead' /><Button
            title='About me'
            href='/about'
          />
        </div>
      </div>
    </section>
    <div id='content' class='home-sections'>
      {
        !!posts.length && (
          <section aria-labelledby='latest-posts'>
            <div class='section-heading'>
              <>
                <h2 id='latest-posts'>Latest posts</h2>
                <a href='/blog'>All posts →</a>
              </>
            </div>
            <ul class='post-list'>
              {posts.map((post) => (
                <PostPreview {post} detailed />
              ))}
            </ul>
          </section>
        )
      }
      <Section title='Background'>
        <div class='background-cards'>
          <Card heading='University of Information Technology: VNUHCM' date='From September 2024' />
          <Card
            heading='IELTS certificate'
            subheading='Overall band score: 7.0'
            date='September 2026'
          />
        </div>
      </Section>
      <Section title='Skills'>
        <SkillLayout title='Languages' skills={['C/C++', 'JavaScript', 'Python', 'Java']} />
        <SkillLayout title='Analysis tools' skills={['IDA', 'adb', 'jadx', 'gdb/gef']} />
        <SkillLayout title='Environment' skills={['VMware', 'Android Studio', 'Docker', 'Kali']} />
      </Section>
    </div>
  </main>
</PageLayout>
<style>
  .home-content {
    max-width: 58rem;
    margin-inline: auto;
  }
  .home-intro {
    display: flex;
    align-items: flex-start;
    gap: clamp(1rem, 4vw, 2rem);
    padding-block: 1rem 2.5rem;
  }
  .home-avatar {
    width: 6rem;
    height: 6rem;
    object-fit: cover;
    border: 1px solid hsl(var(--border));
    border-radius: 1.25rem;
    flex-shrink: 0;
  }
  .intro-eyebrow {
    font: 0.7rem/1.5 monospace;
    letter-spacing: 0.08em;
    color: hsl(var(--primary));
    margin-bottom: 0.5rem;
  }
  h1 {
    font: 500 clamp(2rem, 5vw, 3rem)/1.15 monospace;
  }
  .intro-role {
    margin-top: 1rem;
    font-size: clamp(1rem, 2vw, 1.2rem);
  }
  .intro-description {
    max-width: 45ch;
    margin-top: 0.5rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.7;
  }
  .intro-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.875rem;
  }
  .intro-meta a {
    min-height: 44px;
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .intro-actions :global(a:first-child) {
    background: hsl(var(--primary));
    color: hsl(var(--background));
    border-color: hsl(var(--primary));
  }
  .home-sections {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .section-heading h2 {
    font-size: 1.25rem;
    font-weight: 500;
  }
  .section-heading a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    color: hsl(var(--primary));
  }
  .post-list {
    display: grid;
    gap: 1rem;
  }
  .background-cards {
    display: grid;
    gap: 1rem;
  }
  @media (max-width: 479px) {
    .home-intro {
      flex-direction: column;
    }
    .home-avatar {
      width: 4rem;
      height: 4rem;
    }
  }
</style>
