---
import { BackToTop } from 'astro-pure/components/pages'
import type { SiteMeta } from 'astro-pure/types'
import { Button } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

interface Props {
  meta: SiteMeta
  highlightColor?: string
  back?: string
  lang?: string
  searchable?: boolean
}
const { meta, highlightColor, back = '/', lang, searchable = false, ...props } = Astro.props
const hasSidebar = Astro.slots.has('sidebar')
---

<PageLayout {meta} {highlightColor} {lang} {...props}>
  <Button title='Back' href={back} variant='back' />
  <main class:list={['reading-layout', { 'has-sidebar': hasSidebar }]}>
    {
      hasSidebar && (
        <details id='sidebar' class='toc-panel' open data-pagefind-ignore>
          <summary>
            Contents <span aria-hidden='true'>⌄</span>
          </summary>
          <div class='toc-body'>
            <slot name='sidebar' />
          </div>
        </details>
      )
    }
    <article class='reading-surface' data-pagefind-body={searchable || undefined}>
      <div id='content-header'><slot name='header' /></div>
      <div id='content' class={cn('min-w-0 max-w-none mt-8', integ.typography.class)}><slot /></div>
      <div class='article-bottom' data-pagefind-ignore><slot name='bottom' /></div>
    </article>
  </main>
  <div data-pagefind-ignore><slot name='bottom-sidebar' /></div>
  <BackToTop header='content-header' content='content' />
</PageLayout>
<script>
  let sidebarEvents: AbortController | undefined
  function setupSidebar() {
    sidebarEvents?.abort()
    const sidebar = document.querySelector<HTMLDetailsElement>('#sidebar')
    if (!sidebar) return
    sidebarEvents = new AbortController()
    const { signal } = sidebarEvents
    const wide = window.matchMedia('(min-width: 1024px)')
    const sync = () => {
      sidebar.open = wide.matches
    }
    sync()
    wide.addEventListener('change', sync, { signal })
    sidebar.addEventListener(
      'toc:navigate',
      () => {
        if (!wide.matches) sidebar.open = false
      },
      { signal }
    )
  }
  setupSidebar()
  document.addEventListener('astro:page-load', setupSidebar)
  document.addEventListener('astro:before-swap', () => sidebarEvents?.abort())
</script>
<style>
  .reading-layout {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
    align-items: start;
  }
  .reading-surface {
    min-width: 0;
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid hsl(var(--border));
    border-radius: 1rem;
    background: hsl(var(--card));
  }
  .article-bottom {
    margin-top: 2rem;
  }
  .toc-panel {
    min-width: 0;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    background: hsl(var(--card));
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    padding: 0.75rem 1rem;
    list-style: none;
    font-weight: 500;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .toc-body {
    padding: 1rem;
    max-height: 60dvh;
    overflow-y: auto;
  }
  @media (min-width: 1024px) {
    .has-sidebar {
      grid-template-columns: minmax(0, 1fr) 14rem;
      gap: 2rem;
    }
    .has-sidebar .reading-surface {
      grid-column: 1;
      grid-row: 1;
    }
    .toc-panel {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 6rem;
    }
    .toc-body {
      max-height: calc(100dvh - 8rem);
    }
    summary {
      display: none;
    }
  }
</style>
