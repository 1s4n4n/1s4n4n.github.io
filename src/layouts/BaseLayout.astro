---
import { Footer, Header, ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import AudioPlayer from '@/components/AudioPlayer.astro'
import BaseHead from '@/components/BaseHead.astro'
import TerminalModal from '@/components/TerminalModal.astro'
import config from '@/site-config'

import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
  lang?: string
}
const {
  meta: { articleDate, description = config.description, ogImage, title },
  highlightColor,
  lang = config.locale.lang,
  ...props
} = Astro.props
---

<html lang={lang}>
  <head><BaseHead {articleDate} {description} {ogImage} {title} /><ThemeProvider /></head>
  <body class='relative flex justify-center bg-background text-foreground' {...props}>
    <a class='skip-link' href='#page-content'>Skip to content</a>
    <div class='site-ambient' aria-hidden='true'></div>
    <div id='main-container' class='relative w-full max-w-[76rem] min-h-[100dvh] flex flex-col'>
      <Header />
      <div class='site-tools' data-pagefind-ignore><AudioPlayer /></div>
      <div id='page-content' class='min-w-0 w-full flex-1' tabindex='-1'><slot /></div>
      <Footer />
    </div>
    <TerminalModal />
  </body>
</html>
<style>
  .site-ambient {
    position: absolute;
    inset: 0 0 auto;
    height: 24rem;
    pointer-events: none;
    background: radial-gradient(ellipse at 20% 0%, hsl(var(--primary) / 0.07), transparent 65%);
  }
  #main-container {
    padding-top: env(safe-area-inset-top);
    padding-left: calc(clamp(1rem, 4vw, 2.5rem) + env(safe-area-inset-left));
    padding-right: calc(clamp(1rem, 4vw, 2.5rem) + env(safe-area-inset-right));
    padding-bottom: env(safe-area-inset-bottom);
  }
  :global(.highlight) {
    color: hsl(var(--primary)) !important;
  }
  :global(.highlight-bg) {
    background-color: hsl(var(--primary)) !important;
  }
</style>
