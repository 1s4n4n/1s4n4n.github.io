---
import type { MarkdownHeading, MarkdownLayoutProps } from 'astro'
import config from 'virtual:config'

import { TOC } from 'astro-pure/components/pages'
import { getContentLanguage } from 'astro-pure/utils'
import PageLayout from '@/layouts/ContentLayout.astro'

type Props = MarkdownLayoutProps<{
  title: string
  description: string
  heroImage?: { src: string }
  language?: string
  back?: string
}> & { headings: MarkdownHeading[] }
const {
  frontmatter: { title, description, heroImage, language, back },
  headings
} = Astro.props
---

<PageLayout
  meta={{ title, description, ogImage: heroImage?.src ?? config.socialCard }}
  back={back}
  lang={getContentLanguage(language)}
>
  {!!headings.length && <TOC {headings} slot='sidebar' />}
  <Fragment slot='header'>
    <h1 class='text-2xl sm:text-3xl font-medium'>{title}</h1>
    {description && <p class='mt-4 text-muted-foreground'>{description}</p>}
  </Fragment>
  <slot />
</PageLayout>
