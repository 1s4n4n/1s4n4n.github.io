---

---

<dialog
  id='cli-modal'
  transition:persist='terminal'
  aria-labelledby='cli-title'
  data-pagefind-ignore
>
  <div class='terminal-header'>
    <h2 id='cli-title'>guest@1s4n4n:~</h2>
    <button class='icon-button' id='cli-close' type='button' aria-label='Close terminal'>×</button>
  </div>
  <p id='cli-help'>Type <strong>help</strong> to see commands. Press Escape to close.</p>
  <div id='cli-output' role='log' aria-live='polite' aria-relevant='additions'></div>
  <form id='cli-form'>
    <label for='cli-input' aria-label='Command'>&gt;</label>
    <input
      id='cli-input'
      type='text'
      autocomplete='off'
      spellcheck='false'
      autofocus
      aria-label='Terminal command'
      aria-describedby='cli-help'
      placeholder='help, ls, cat about…'
    />
    <button type='submit' class='icon-button' aria-label='Run command'>↵</button>
  </form>
</dialog>
<style>
  dialog {
    width: min(42rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    color: hsl(var(--foreground));
    background: hsl(var(--card));
    font: 0.875rem/1.6 monospace;
    box-shadow: 0 20px 80px #0004;
  }
  dialog::backdrop {
    background: #0009;
  }
  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  h2,
  label,
  strong {
    color: hsl(var(--primary));
  }
  h2 {
    font-size: 0.875rem;
    font-weight: 600;
  }
  #cli-help {
    color: hsl(var(--muted-foreground));
    margin-block: 1rem;
  }
  #cli-output {
    max-height: min(45dvh, 24rem);
    overflow: auto;
    overflow-wrap: anywhere;
  }
  #cli-output :global(.command-line) {
    margin-block: 0.75rem;
    white-space: pre-wrap;
  }
  #cli-output :global(.command-echo) {
    color: hsl(var(--muted-foreground));
  }
  form {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding-top: 0.75rem;
    margin-top: 1rem;
    border-top: 1px solid hsl(var(--border));
  }
  input {
    min-width: 0;
    width: 100%;
    min-height: 44px;
    color: hsl(var(--foreground));
    background: hsl(var(--muted));
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    padding: 0.5rem;
    font-size: 1rem;
  }
</style>
<script>
  import { navigate } from 'astro:transitions/client'

  const modal = document.querySelector<HTMLDialogElement>('#cli-modal')!
  const input = modal.querySelector<HTMLInputElement>('#cli-input')!
  const output = modal.querySelector<HTMLElement>('#cli-output')!
  const open = () => {
    if (!modal.open) {
      modal.showModal()
      input.focus()
    }
  }
  document.addEventListener('click', (event) => {
    if ((event.target as Element).closest('[data-open-terminal]')) open()
  })
  document.addEventListener('astro:before-swap', () => {
    if (modal.open) modal.close()
  })
  modal.querySelector('#cli-close')!.addEventListener('click', () => modal.close())
  modal.addEventListener('click', (event) => {
    const rect = modal.getBoundingClientRect()
    if (
      event.target === modal &&
      (event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom)
    )
      modal.close()
  })
  window.addEventListener('keydown', (event) => {
    const typing = (event.target as HTMLElement)?.closest(
      'input, textarea, [contenteditable="true"]'
    )
    if (
      (!typing && event.key === '`') ||
      ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k')
    ) {
      event.preventDefault()
      if (modal.open) modal.close()
      else open()
    }
  })
  const commands: Record<string, string> = {
    help: 'Available commands:\n  cd [page]  Navigate to a page\n  ls         List pages\n  cat about  About me\n  whoami     Current identity\n  flag       A little surprise\n  clear      Clear output\n  exit       Close terminal',
    ls: 'home/\nblog/\nprojects/\nabout/',
    'cat about':
      'Attack - Defense CTF Player & Mobile Security Enthusiast.\nExploring Mobile Security, Reverse Engineering & Web Security.',
    whoami: 'root:1s4n4n (guest session authenticated)',
    flag: 'FLAG{c4_2_t0t_h4y_x4u_43_t40_ch0n_c4_2}'
  }
  const routes: Record<string, string> = {
    '~': '/',
    '..': '/',
    home: '/',
    blog: '/blog',
    projects: '/projects',
    about: '/about'
  }
  modal.querySelector('form')!.addEventListener('submit', (event) => {
    event.preventDefault()
    const value = input.value.trim()
    if (!value) return
    input.value = ''
    const command = value.toLowerCase()
    if (command === 'exit') {
      modal.close()
      return
    }
    if (command === 'clear') {
      output.replaceChildren()
      return
    }
    let response = commands[command] || `Command not found: ${value}. Type 'help' for commands.`
    const [action, destination = '~'] = command.split(/\s+/)
    if (action === 'cd') {
      const target = destination.replace(/\/$/, '')
      if (routes[target]) {
        modal.close()
        void navigate(routes[target])
        return
      }
      response = `cd: no such directory: ${destination}`
    }
    const line = document.createElement('div')
    line.className = 'command-line'
    const echo = document.createElement('div')
    echo.className = 'command-echo'
    echo.textContent = `> ${value}`
    const result = document.createElement('div')
    result.textContent = response
    line.append(echo, result)
    output.append(line)
    output.scrollTop = output.scrollHeight
  })
</script>
