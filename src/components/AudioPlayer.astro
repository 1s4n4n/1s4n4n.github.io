---

---

<details id='cyber-audio-player' transition:persist='music-player' data-pagefind-ignore>
  <summary>Music <span id='audio-state'>Off</span></summary>
  <div class='player-panel'>
    <p class='player-caption'>Listen while you browse</p>
    <p id='audio-current-title' class='track-title'>Maktone · Razor1911</p>
    <audio id='bgm-media' preload='none'></audio>
    <div class='player-controls'>
      <button id='audio-play-btn' type='button' aria-pressed='false'>Play</button>
      <button id='audio-next-btn' type='button'>Next track</button>
    </div>
    <ul id='playlist-items' aria-label='Choose a track'></ul>
    <p id='audio-feedback' role='status'>Music starts only when you press Play.</p>
  </div>
</details>
<style>
  details {
    position: relative;
    font-size: 0.875rem;
  }
  summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    list-style: none;
    border-radius: var(--radius);
    padding: 0.5rem 0.75rem;
    color: hsl(var(--muted-foreground));
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card));
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::before {
    content: '♫';
    color: hsl(var(--primary));
  }
  summary span {
    font-size: 0.75rem;
  }
  .player-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 45;
    width: min(21rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    background: hsl(var(--card));
    box-shadow: 0 12px 30px #0002;
  }
  .player-caption,
  #audio-feedback {
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
  }
  .track-title {
    margin-block: 0.5rem 1rem;
    font-weight: 600;
  }
  .player-controls {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  button {
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
  }
  ul {
    margin-block: 0.75rem;
  }
  li + li {
    margin-top: 0.25rem;
  }
  li :global(button) {
    width: 100%;
    text-align: left;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
  }
  li :global(button[aria-current='true']) {
    color: hsl(var(--primary));
    border-color: hsl(var(--primary));
  }
</style>
<script>
  const playlist = [
    { title: 'Maktone', artist: 'Razor1911', src: '/audio/bgm.mp3' },
    { title: 'MTC', artist: 'S3RL', src: '/audio/bgm2.mp3' },
    { title: 'Pika Girl', artist: 'S3RL', src: '/audio/bgm3.mp3' }
  ]
  const root = document.querySelector<HTMLDetailsElement>('#cyber-audio-player')!
  const audio = root.querySelector<HTMLAudioElement>('audio')!
  const play = root.querySelector<HTMLButtonElement>('#audio-play-btn')!
  const title = root.querySelector<HTMLElement>('#audio-current-title')!
  const state = root.querySelector<HTMLElement>('#audio-state')!
  const feedback = root.querySelector<HTMLElement>('#audio-feedback')!
  const list = root.querySelector<HTMLUListElement>('#playlist-items')!
  const read = (key: string) => {
    try {
      return localStorage.getItem(key)
    } catch {
      return null
    }
  }
  const save = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value)
    } catch {}
  }
  let index = Number(read('bgm_index') || 0)
  if (!Number.isInteger(index) || !playlist[index]) index = 0
  let loadedIndex = -1
  function render() {
    title.textContent = `${playlist[index].title} · ${playlist[index].artist}`
    list
      .querySelectorAll('button')
      .forEach((button, i) => button.setAttribute('aria-current', String(i === index)))
  }
  async function start() {
    play.disabled = true
    try {
      if (loadedIndex !== index) {
        audio.src = playlist[index].src
        loadedIndex = index
        const savedTime = Number(read('bgm_time') || 0)
        const sameTrack = Number(read('bgm_index') || 0) === index
        audio.addEventListener(
          'loadedmetadata',
          () => {
            if (
              sameTrack &&
              Number.isFinite(savedTime) &&
              savedTime > 0 &&
              savedTime < audio.duration
            )
              audio.currentTime = savedTime
          },
          { once: true }
        )
        save('bgm_index', String(index))
      }
      await audio.play()
      feedback.textContent = 'Pause here whenever you want.'
    } catch {
      feedback.textContent = 'Unable to play this track. Please try again.'
    } finally {
      play.disabled = false
    }
  }
  playlist.forEach((track, i) => {
    const li = document.createElement('li')
    const button = document.createElement('button')
    button.type = 'button'
    button.textContent = `${track.title} · ${track.artist}`
    button.addEventListener('click', () => {
      index = i
      render()
      void start()
    })
    li.append(button)
    list.append(li)
  })
  render()
  play.addEventListener('click', () => {
    if (audio.paused) void start()
    else audio.pause()
  })
  const next = () => {
    index = (index + 1) % playlist.length
    render()
    void start()
  }
  root.querySelector('#audio-next-btn')!.addEventListener('click', next)
  audio.addEventListener('ended', next)
  const update = () => {
    play.textContent = audio.paused ? 'Play' : 'Pause'
    play.setAttribute('aria-pressed', String(!audio.paused))
    state.textContent = audio.paused ? 'Off' : 'Playing'
  }
  audio.addEventListener('play', update)
  audio.addEventListener('pause', update)
  window.addEventListener('pagehide', () => {
    if (loadedIndex >= 0) save('bgm_time', String(audio.currentTime))
  })
  document.addEventListener('click', (event) => {
    if (!root.contains(event.target as Node)) root.open = false
  })
  root.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      root.open = false
      root.querySelector('summary')?.focus()
    }
  })
</script>
