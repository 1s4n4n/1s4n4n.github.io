---
---

<div
  id="cyber-audio-player"
  class="absolute top-[3.75rem] left-4 sm:left-7 lg:left-10 z-40 flex items-center font-mono text-xs select-none"
>
  <audio id="bgm-media" preload="auto"></audio>

  {/* Popup Playlist: Đổ từ góc trái xuống */}
  <div 
    id="player-playlist" 
    class="hidden absolute left-0 top-full mt-2 z-50 w-72 max-w-[85vw] rounded-xl border border-red-500/40 bg-[#0d0608]/95 p-3 shadow-[0_0_25px_rgba(225,29,72,0.4)] backdrop-blur-md"
  >
    <div class="flex items-center gap-3 pb-2.5 border-b border-red-950/80 mb-2">
      <img 
        id="player-cover-banner" 
        src="/audio/cover1.jpg" 
        alt="Track Cover" 
        class="size-10 rounded-lg object-cover border border-red-500/30 shrink-0"
      />
      <div class="overflow-hidden">
        <p id="player-banner-title" class="truncate font-semibold text-red-300 text-xs">Track Title</p>
        <p id="player-banner-artist" class="truncate text-muted-foreground text-[10px]">Artist</p>
      </div>
    </div>

    <div class="text-[10px] font-bold text-red-400 pb-1 mb-1 flex justify-between items-center">
      <span>PLAYLIST</span>
      <span id="playlist-count" class="text-muted-foreground text-[9px]"></span>
    </div>

    <ul id="playlist-items" class="space-y-1 max-h-40 overflow-y-auto pr-1 text-xs"></ul>
  </div>

  {/* Mini Player Bar: Nằm dưới chữ 1s4n4n góc trái */}
  <div 
    id="player-bar"
    class="flex items-center gap-2 rounded-full border border-red-500/40 bg-[#0d0608]/85 px-2.5 py-1 shadow-[0_0_12px_rgba(225,29,72,0.25)] backdrop-blur-md transition-all duration-300"
  >
    {/* Đĩa nhạc xoay tròn */}
    <img 
      id="player-mini-thumb" 
      src="/audio/cover1.jpg" 
      alt="Track" 
      class="size-5 rounded-full object-cover border border-red-500/50 shrink-0 cursor-pointer"
      title="Toggle playlist"
    />

    {/* Equalizer */}
    <div id="audio-equalizer" class="flex items-end gap-[2px] h-2.5 opacity-60 shrink-0">
      <span class="eq-bar w-[2px] bg-red-500 rounded-full h-1"></span>
      <span class="eq-bar w-[2px] bg-red-500 rounded-full h-2"></span>
      <span class="eq-bar w-[2px] bg-red-500 rounded-full h-1.5"></span>
    </div>

    {/* Nút Play / Pause */}
    <button id="audio-play-btn" class="text-muted-foreground hover:text-red-400 transition-colors p-0.5 text-xs" aria-label="Play/Pause">
      <span id="audio-play-icon">▶</span>
    </button>

    {/* Tên bài hát */}
    <span id="audio-current-title" class="max-w-[80px] sm:max-w-[110px] truncate text-red-200">Track 01</span>

    {/* Nút Next */}
    <button id="audio-next-btn" class="text-muted-foreground hover:text-red-400 transition-colors text-[9px] p-0.5" aria-label="Next track">
      ⏭
    </button>

    {/* Nút Toggle mở Playlist */}
    <button id="audio-list-btn" class="text-muted-foreground hover:text-red-400 transition-colors text-[10px] border-l border-red-950 pl-2" aria-label="Toggle playlist">
      ☰
    </button>
  </div>
</div>

<style>
  .playing .eq-bar:nth-child(1) { animation: bounce 0.8s ease-in-out infinite alternate; }
  .playing .eq-bar:nth-child(2) { animation: bounce 0.6s ease-in-out infinite 0.2s alternate; }
  .playing .eq-bar:nth-child(3) { animation: bounce 1.0s ease-in-out infinite 0.4s alternate; }

  @keyframes bounce {
    0% { height: 2px; }
    100% { height: 10px; }
  }

  .playing-thumb {
    animation: rotateThumb 8s linear infinite;
  }
  @keyframes rotateThumb {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

<script>
  const playlist = [
    { 
      title: 'Maktone', 
      artist: 'Razor1911', 
      cover: '/audio/cover1.jpg',
      src: '/audio/bgm.mp3' 
    },
    { 
      title: 'MTC', 
      artist: 'S3RL', 
      cover: '/audio/cover2.jpg',
      src: '/audio/bgm2.mp3' 
    },
    { 
      title: 'Pika Girl', 
      artist: 'S3RL', 
      cover: '/audio/cover3.jpg',
      src: '/audio/bgm3.mp3' 
    }
  ];

  function setupPersistentPlayer() {
    const audio = document.getElementById('bgm-media') as HTMLAudioElement | null;
    const playBtn = document.getElementById('audio-play-btn');
    const playIcon = document.getElementById('audio-play-icon');
    const nextBtn = document.getElementById('audio-next-btn');
    const listBtn = document.getElementById('audio-list-btn');
    const titleEl = document.getElementById('audio-current-title');
    const eq = document.getElementById('audio-equalizer');
    const playlistBox = document.getElementById('player-playlist');
    const playlistUl = document.getElementById('playlist-items');
    const playlistCount = document.getElementById('playlist-count');

    const coverBanner = document.getElementById('player-cover-banner') as HTMLImageElement | null;
    const bannerTitle = document.getElementById('player-banner-title');
    const bannerArtist = document.getElementById('player-banner-artist');
    const miniThumb = document.getElementById('player-mini-thumb') as HTMLImageElement | null;

    if (!audio || !playBtn || !titleEl || !eq || !playlistBox || !playlistUl) return;

    const savedIndex = parseInt(localStorage.getItem('bgm_index') || '0', 10);
    let currentIndex = (savedIndex >= 0 && savedIndex < playlist.length) ? savedIndex : 0;
    const isPlaying = localStorage.getItem('bgm_playing') === 'true';
    const savedTime = parseFloat(localStorage.getItem('bgm_time') || '0');

    function renderPlaylist() {
      playlistUl.innerHTML = '';
      if (playlistCount) playlistCount.textContent = `${playlist.length} tracks`;

      playlist.forEach((track, idx) => {
        const li = document.createElement('li');
        li.className = `flex items-center justify-between gap-2 px-2 py-1 rounded cursor-pointer transition-colors ${
          idx === currentIndex ? 'bg-red-950/60 text-red-300 font-semibold' : 'text-muted-foreground hover:bg-red-950/30'
        }`;
        li.innerHTML = `
          <span class="truncate max-w-[140px]">${track.title}</span>
          <span class="text-[10px] opacity-60">${track.artist}</span>
        `;
        li.addEventListener('click', () => {
          currentIndex = idx;
          loadTrack(currentIndex);
          audio.currentTime = 0;
          audio.play().catch(console.error);
        });
        playlistUl.appendChild(li);
      });
    }

    function updateUI(playing: boolean) {
      if (playing) {
        eq.classList.add('playing');
        eq.classList.remove('opacity-60');
        miniThumb?.classList.add('playing-thumb');
        if (playIcon) playIcon.textContent = '⏸';
      } else {
        eq.classList.remove('playing');
        eq.classList.add('opacity-60');
        miniThumb?.classList.remove('playing-thumb');
        if (playIcon) playIcon.textContent = '▶';
      }
      renderPlaylist();
    }

    function loadTrack(idx: number) {
      const track = playlist[idx];
      if (!track) return;

      audio.src = track.src;
      titleEl.textContent = track.title;

      if (coverBanner) coverBanner.src = track.cover;
      if (bannerTitle) bannerTitle.textContent = track.title;
      if (bannerArtist) bannerArtist.textContent = track.artist;
      if (miniThumb) miniThumb.src = track.cover;

      localStorage.setItem('bgm_index', idx.toString());
      renderPlaylist();
    }

    loadTrack(currentIndex);

    if (isPlaying) {
      audio.currentTime = savedTime;
      audio.play().then(() => {
        updateUI(true);
      }).catch(() => {
        const resumeOnClick = () => {
          audio.play().then(() => updateUI(true)).catch(() => {});
          window.removeEventListener('pointerdown', resumeOnClick);
        };
        window.addEventListener('pointerdown', resumeOnClick, { once: true });
      });
    }

    audio.addEventListener('timeupdate', () => {
      localStorage.setItem('bgm_time', audio.currentTime.toString());
    });

    audio.addEventListener('play', () => {
      localStorage.setItem('bgm_playing', 'true');
      updateUI(true);
    });

    audio.addEventListener('pause', () => {
      localStorage.setItem('bgm_playing', 'false');
      updateUI(false);
    });

    audio.addEventListener('ended', () => {
      currentIndex = (currentIndex + 1) % playlist.length;
      loadTrack(currentIndex);
      audio.currentTime = 0;
      audio.play().catch(console.error);
    });

    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play().catch(console.error);
      } else {
        audio.pause();
      }
    });

    nextBtn?.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % playlist.length;
      loadTrack(currentIndex);
      audio.currentTime = 0;
      audio.play().catch(console.error);
    });

    const togglePlaylist = () => {
      playlistBox.classList.toggle('hidden');
    };

    listBtn?.addEventListener('click', togglePlaylist);
    miniThumb?.addEventListener('click', togglePlaylist);

  document.addEventListener('pointerdown', (e) => {
  const target = e.target as HTMLElement;
  const player = document.getElementById('cyber-audio-player');
  if (player && !player.contains(target)) {
    playlistBox.classList.add('hidden');
  }
  });

  playlistUl.addEventListener('click', (e) => {
  if ((e.target as HTMLElement).closest('li')) {
    playlistBox.classList.add('hidden');
  }
  });

    window.addEventListener('beforeunload', () => {
      localStorage.setItem('bgm_time', audio.currentTime.toString());
    });
  }

  setupPersistentPlayer();
</script>