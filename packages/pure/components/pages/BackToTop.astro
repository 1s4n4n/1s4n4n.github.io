---
import { Icon } from '../user'

const { header: headerName, content: contentName, needPercent = true } = Astro.props
---

<div
  class='z-10 md:z-50 group fixed bottom-8 end-4 transition-all flex flex-col gap-y-4 sm:end-8'
  id='action-buttons'
>
  <slot name='other-icons' />
  <scroll-button
    data-header={headerName}
    data-content={contentName}
    data-percent={String(needPercent)}
  >
    <button
      aria-label='Back to Top'
      class='relative size-12 flex items-center justify-center rounded-full border-2 border-transparent bg-muted text-muted-foreground duration-300 hover:border-border/75 opacity-0'
      id='to-top-btn'
    >
      <div
        class='top-text absolute bottom-0 end-0 start-0 top-0 flex items-center justify-center group-[.ended]:opacity-0'
      >
        <span class='text'>10</span>
        <span class='text-xs'>%</span>
      </div>
      <Icon name='up' class='top-icon group-[.ended]:opacity-100' />
    </button>
  </scroll-button>
</div>

<script>
  class ScrollBtn extends HTMLElement {
    private events?: AbortController
    private observer?: IntersectionObserver
    private resizeObserver?: ResizeObserver
    private frame = 0

    connectedCallback() {
      this.events?.abort()
      this.events = new AbortController()
      const { signal } = this.events
      const actionButtons = this.closest<HTMLElement>('#action-buttons')!
      const button = this.querySelector<HTMLButtonElement>('button')!
      const percentText = button.querySelector<HTMLElement>('.top-text .text')!
      const header = document.getElementById(this.dataset.header || '')
      const content = document.getElementById(this.dataset.content || '')
      const needPercent = this.dataset.percent === 'true' && !!content

      button.addEventListener(
        'click',
        () => {
          window.scrollTo({
            top: 0,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
              ? 'auto'
              : 'smooth'
          })
        },
        { signal }
      )

      if (header) {
        this.observer = new IntersectionObserver(([entry]) => {
          actionButtons.classList.toggle('show', !entry.isIntersecting)
        })
        this.observer.observe(header)
      }

      const update = () => {
        this.frame = 0
        if (!needPercent || !content) {
          actionButtons.classList.add('ended')
          return
        }
        const top = content.getBoundingClientRect().top + window.scrollY
        const distance = content.scrollHeight - window.innerHeight
        const progress =
          distance > 0
            ? Math.min(100, Math.max(0, Math.round(((window.scrollY - top) / distance) * 100)))
            : 100
        percentText.textContent = String(progress)
        actionButtons.classList.toggle('ended', progress >= 100)
      }
      const schedule = () => {
        if (!this.frame) this.frame = requestAnimationFrame(update)
      }
      window.addEventListener('scroll', schedule, { passive: true, signal })
      window.addEventListener('resize', schedule, { signal })
      if (content) {
        this.resizeObserver = new ResizeObserver(schedule)
        this.resizeObserver.observe(content)
      }
      update()
    }

    disconnectedCallback() {
      this.events?.abort()
      this.observer?.disconnect()
      this.resizeObserver?.disconnect()
      cancelAnimationFrame(this.frame)
      this.frame = 0
    }
  }
  if (!customElements.get('scroll-button')) customElements.define('scroll-button', ScrollBtn)
</script>

<style>
  #action-buttons {
    transform: translateY(4rem);
    &.show {
      transform: translateY(0);
      & #to-top-btn {
        opacity: 1;
      }
    }

    /* To top button status change */
    & #to-top-btn {
      & .top-text,
      & .top-icon {
        transition-property: opacity;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 150ms;
      }
      & .top-text {
        opacity: 1;
      }
      & .top-icon {
        opacity: 0;
      }
    }
    &.ended #to-top-btn,
    & #to-top-btn:hover {
      & .top-text {
        opacity: 0;
      }
      & .top-icon {
        opacity: 1;
      }
    }
  }
</style>
