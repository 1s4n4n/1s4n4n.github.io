---
import type { MarkdownHeading } from 'astro'

import { generateToc } from '../../plugins/toc'
import { cn } from '../../utils'
import TOCHeading from './TOCHeading.astro'

interface Props {
  headings: MarkdownHeading[]
  class?: string
  id?: string
}
const { headings, class: className, ...props } = Astro.props
const toc = generateToc(headings)
---

<toc-heading class={cn('toc-drawer-content', className)} {...props}>
  <nav aria-label='Table of contents'>
    <ul>{toc.map((heading) => <TOCHeading heading={heading} />)}</ul>
  </nav>
</toc-heading>
<script>
  class TOC extends HTMLElement {
    private events?: AbortController
    private frame = 0

    connectedCallback() {
      this.events?.abort()
      this.events = new AbortController()
      const { signal } = this.events
      const links = Array.from(this.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'))
      const headings = links
        .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
        .filter((node): node is HTMLElement => !!node)
      const update = () => {
        const active =
          [...headings].reverse().find((heading) => heading.getBoundingClientRect().top <= 130) ||
          headings[0]
        links.forEach((link) => {
          const current = decodeURIComponent(link.hash.slice(1)) === active?.id
          link.classList.toggle('highlight', current)
          if (current) link.setAttribute('aria-current', 'location')
          else link.removeAttribute('aria-current')
        })
        this.frame = 0
      }
      const onScroll = () => {
        if (!this.frame) this.frame = requestAnimationFrame(update)
      }
      window.addEventListener('scroll', onScroll, { passive: true, signal })
      this.addEventListener(
        'click',
        (event) => {
          const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]')
          if (!link) return
          this.dispatchEvent(new CustomEvent('toc:navigate', { bubbles: true }))
        },
        { signal }
      )
      update()
    }

    disconnectedCallback() {
      this.events?.abort()
      cancelAnimationFrame(this.frame)
      this.frame = 0
    }
  }
  if (!customElements.get('toc-heading')) customElements.define('toc-heading', TOC)
</script>
<style>
  toc-heading {
    display: block;
  }
  toc-heading :global(.toc-item) {
    min-height: 44px;
    display: flex;
    align-items: center;
    overflow-wrap: anywhere;
    touch-action: manipulation;
  }
</style>
