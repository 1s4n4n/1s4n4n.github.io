---
import { Image } from 'astro:assets'
import type { InferEntrySchema } from 'astro:content'

import { getTagUrl } from '../../utils'
import { FormattedDate, Icon } from '../user'

interface Props {
  data: InferEntrySchema<'blog'>
  remarkPluginFrontmatter: Record<string, unknown>
}
const {
  data: { title, description, draft, heroImage, publishDate, updatedDate, tags, language },
  remarkPluginFrontmatter
} = Astro.props
---

<header class='article-info'>
  {draft && <span class='text-primary'>(Draft)</span>}
  <h1 class='text-2xl sm:text-3xl font-medium leading-tight' data-pagefind-meta='title'>{title}</h1>
  <p class='article-description text-muted-foreground'>{description}</p>
  <div
    class='header-meta flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground'
  >
    <FormattedDate date={publishDate} />
    {
      updatedDate && (
        <span>
          Updated <FormattedDate date={updatedDate} />
        </span>
      )
    }
    <span class='inline-flex items-center gap-1'
      ><Icon name='time' class='size-4' />{remarkPluginFrontmatter.minutesRead}</span
    >
    {language && <span>{language}</span>}
  </div>
  {
    !!tags?.length && (
      <ul class='article-tags' aria-label='Tags'>
        {tags.map((tag) => (
          <li>
            <a href={getTagUrl(tag)} data-pagefind-filter='tag'>
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  {
    heroImage && (
      <div class='hero-image'>
        <Image
          {...heroImage}
          alt={heroImage.alt || title}
          loading='eager'
          fetchpriority='high'
          class='cover-image'
        />
      </div>
    )
  }
  <slot name='description' />
</header>
<style>
  h1 {
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .article-description {
    margin-block: 1rem;
    font-size: 1rem;
    line-height: 1.7;
  }
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin-top: 0.75rem;
  }
  .article-tags a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.25rem 0.625rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
    overflow-wrap: anywhere;
  }
  .hero-image {
    margin-top: 1.5rem;
    border-radius: var(--radius);
    background: hsl(var(--muted));
    overflow: hidden;
  }
  .cover-image {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(35dvh, 20rem);
    object-fit: contain;
    margin-inline: auto;
  }
</style>
