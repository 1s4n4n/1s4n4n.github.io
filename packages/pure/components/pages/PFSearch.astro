---
import '@pagefind/default-ui/css/ui.css'
---

<site-search>
  <p class='search-status' role='status'>Loading search…</p>
  {
    import.meta.env.DEV ? (
      <p>Search is available in the production preview.</p>
    ) : (
      <div id='site-search' />
    )
  }
  <noscript
    >Enable JavaScript to search. You can also browse <a href='/blog'>all posts</a>.</noscript
  >
</site-search>
<script>
  class SiteSearch extends HTMLElement {
    async connectedCallback() {
      const status = this.querySelector<HTMLElement>('.search-status')!
      if (!this.querySelector('#site-search')) {
        status.hidden = true
        return
      }
      if (this.dataset.ready) return
      this.dataset.ready = 'true'
      try {
        // @ts-expect-error Pagefind does not provide default UI declarations.
        const { PagefindUI } = await import('@pagefind/default-ui')
        new PagefindUI({
          element: '#site-search',
          baseUrl: import.meta.env.BASE_URL,
          bundlePath: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/`,
          showImages: false,
          showSubResults: true
        })
        status.hidden = true
      } catch {
        status.textContent = 'Search could not load. Please refresh or browse all posts.'
      }
    }
  }
  if (!customElements.get('site-search')) customElements.define('site-search', SiteSearch)
</script>
<style>
  site-search {
    display: block;
    margin-block: 1rem;
  }
  #site-search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: hsl(var(--primary));
    --pagefind-ui-text: hsl(var(--foreground));
    --pagefind-ui-background: hsl(var(--card));
    --pagefind-ui-border: hsl(var(--border));
    --pagefind-ui-tag: hsl(var(--muted));
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.75rem;
    --pagefind-ui-font: inherit;
  }
</style>
