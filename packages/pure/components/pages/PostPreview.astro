---
import { Image } from 'astro:assets'
import { render, type CollectionEntry, type CollectionKey } from 'astro:content'

import { cn, getTagUrl } from '../../utils'
import { FormattedDate } from '../user'

type Props<T extends CollectionKey> = {
  post: CollectionEntry<T>
  detailed?: boolean
  class?: string
}
const { post, detailed = false, class: className } = Astro.props
const { id, data } = post
const { remarkPluginFrontmatter } = await render(post)
---

<li class={cn('post-preview', className, { detailed, 'has-cover': detailed && data.heroImage })}>
  {
    detailed && data.heroImage && (
      <a
        class='post-cover'
        href={`/blog/${id}`}
        aria-label={`Read ${data.title}`}
        data-astro-prefetch
      >
        <Image
          src={data.heroImage.src}
          alt={data.heroImage.alt ?? ''}
          widths={[320, 480, 640, 960]}
          sizes='(min-width: 640px) 22rem, calc(100vw - 4rem)'
          loading='lazy'
        />
      </a>
    )
  }
  <div class='post-details'>
    <FormattedDate
      class='post-date text-xs text-muted-foreground'
      date={data.updatedDate ?? data.publishDate}
    />
    <h2 class='post-title'>
      <a href={`/blog/${id}`} data-astro-prefetch
        >{data.draft && '(Draft) '}{data.title}<span aria-hidden='true'>↗</span></a
      >
    </h2>
    {
      detailed && (
        <>
          <p class='post-description text-muted-foreground'>{data.description}</p>
          <div class='post-meta text-muted-foreground'>
            <span>{remarkPluginFrontmatter.minutesRead}</span>
            {data.language && <span>{data.language}</span>}
          </div>
          {!!data.tags.length && (
            <ul class='tag-list' aria-label='Tags'>
              {data.tags.map((tag: string) => (
                <li>
                  <a href={getTagUrl(tag)}>{tag}</a>
                </li>
              ))}
            </ul>
          )}
        </>
      )
    }
  </div>
</li>
<style>
  .post-preview {
    min-width: 0;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
    background: hsl(var(--card));
  }
  .post-date {
    display: block;
    padding-top: 0.5rem;
  }
  .post-details {
    min-width: 0;
  }
  .post-cover {
    display: block;
    overflow: hidden;
    border-radius: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .post-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .post-title {
    font-weight: 500;
    line-height: 1.5;
  }
  .post-title a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 44px;
    overflow-wrap: anywhere;
  }
  .post-title a span {
    color: hsl(var(--primary));
    flex-shrink: 0;
  }
  .post-description {
    font-size: 0.9rem;
    line-height: 1.6;
    margin-block: 0.25rem 0.75rem;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.8rem;
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }
  .tag-list li {
    min-width: 0;
    max-width: 100%;
  }
  .tag-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.375rem 0.625rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    background: hsl(var(--muted));
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
    overflow-wrap: anywhere;
  }
  a:hover {
    color: hsl(var(--primary));
  }
  @media (min-width: 640px) {
    .post-preview:not(.detailed) .post-details {
      display: grid;
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: 0.75rem;
    }
    .detailed {
      padding: 1.25rem;
    }
    .has-cover {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
      align-items: start;
      gap: 1.25rem;
    }
    .post-cover {
      margin-bottom: 0;
    }
  }
</style>
