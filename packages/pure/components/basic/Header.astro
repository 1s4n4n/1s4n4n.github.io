---
import config from 'virtual:config'

import { Icon } from '../user'

const path = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header-component data-pagefind-ignore>
  <a class='brand' href='/' aria-label={`${config.title} home`}
    >{config.title}<span aria-hidden='true'>_</span></a
  >
  <nav id='headerExpandContent' aria-label='Main navigation'>
    {
      config.header.menu.map((item) => (
        <a
          href={item.link}
          aria-current={path === item.link || path.startsWith(`${item.link}/`) ? 'page' : undefined}
          data-astro-prefetch
        >
          {item.title}
        </a>
      ))
    }
  </nav>
  <div class='header-actions'>
    <a class='icon-button' href='/search' aria-label='Search blog' title='Search blog'
      ><Icon name='search' class='size-5' /></a
    >
    <button
      class='icon-button terminal-trigger'
      type='button'
      data-open-terminal
      aria-label='Open terminal'
      title='Open terminal (Ctrl+K)'><span aria-hidden='true'>&gt;_</span></button
    >
    <button
      id='toggleDarkMode'
      class='icon-button'
      type='button'
      aria-label='Theme: system. Change theme'
      title='Theme: system'
    >
      <Icon class='theme-system size-5' name='computer' /><Icon
        class='theme-light size-5'
        name='sun'
      /><Icon class='theme-dark size-5' name='moon' />
    </button>
    <button
      id='toggleMenu'
      class='icon-button menu-toggle'
      type='button'
      aria-controls='headerExpandContent'
      aria-expanded='false'
      aria-label='Open navigation menu'><Icon name='menu' class='size-5' /></button
    >
  </div>
</header-component>
<script>
  import { getTheme, setTheme } from '../../utils'

  class HeaderComponent extends HTMLElement {
    connectedCallback() {
      const themeButton = this.querySelector<HTMLButtonElement>('#toggleDarkMode')!
      const menuButton = this.querySelector<HTMLButtonElement>('#toggleMenu')!
      const updateThemeLabel = (theme: string) => {
        themeButton.dataset.theme = theme
        themeButton.setAttribute('aria-label', `Theme: ${theme}. Change theme`)
        themeButton.title = `Theme: ${theme}`
      }
      updateThemeLabel(getTheme() || 'system')
      themeButton.addEventListener('click', () =>
        updateThemeLabel(setTheme(undefined, true) || 'system')
      )
      const closeMenu = () => {
        this.classList.remove('expanded')
        menuButton.setAttribute('aria-expanded', 'false')
        menuButton.setAttribute('aria-label', 'Open navigation menu')
      }
      menuButton.addEventListener('click', () => {
        const expanded = this.classList.toggle('expanded')
        menuButton.setAttribute('aria-expanded', String(expanded))
        menuButton.setAttribute(
          'aria-label',
          expanded ? 'Close navigation menu' : 'Open navigation menu'
        )
      })
      this.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.classList.contains('expanded')) {
          closeMenu()
          menuButton.focus()
        }
      })
      document.addEventListener('click', (event) => {
        if (!this.contains(event.target as Node)) closeMenu()
      })
    }
  }
  if (!customElements.get('header-component'))
    customElements.define('header-component', HeaderComponent)
</script>
<style>
  header-component {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 5rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--background) / 0.97);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: monospace;
    font-size: 1.4rem;
    font-weight: 600;
    margin-right: auto;
  }
  .brand span {
    color: hsl(var(--primary));
  }
  nav {
    display: flex;
    gap: 0.25rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius);
    font-weight: 500;
  }
  nav a[aria-current='page'] {
    color: hsl(var(--primary));
    background: hsl(var(--muted));
  }
  .header-actions {
    display: flex;
    gap: 0.5rem;
  }
  .terminal-trigger {
    font-family: monospace;
    font-weight: 600;
  }
  .header-actions .menu-toggle,
  .theme-light,
  .theme-dark {
    display: none;
  }
  [data-theme='light'] .theme-system,
  [data-theme='dark'] .theme-system {
    display: none;
  }
  [data-theme='light'] .theme-light,
  [data-theme='dark'] .theme-dark {
    display: block;
  }
  @media (max-width: 719px) {
    header-component {
      gap: 0.5rem;
      min-height: 4.5rem;
    }
    .header-actions {
      gap: 0.375rem;
    }
    .header-actions .menu-toggle {
      display: inline-flex;
    }
    nav {
      display: none;
      position: absolute;
      top: calc(100% + 0.5rem);
      inset-inline: 0;
      flex-direction: column;
      padding: 0.5rem;
      border: 1px solid hsl(var(--border));
      border-radius: var(--radius);
      background: hsl(var(--card));
      box-shadow: 0 12px 24px #0002;
    }
    .expanded nav {
      display: flex;
    }
  }
</style>
<style>
  @media (max-width: 359px) {
    header-component {
      gap: 0.25rem;
    }
    .brand {
      font-size: 1.1rem;
    }
    .header-actions {
      gap: 0.25rem;
    }
  }
</style>
